[Unit]
Description=Barn Owl team app API (FastAPI, EthanChen5291/poc), behind Caddy at /api
After=network-online.target
Wants=network-online.target

[Service]
User=poc
Group=poc
WorkingDirectory=/srv/poc/src/api
Environment=BARN_OWL_DATA_DIR=/srv/poc/src
Environment=BARN_OWL_EVENTS_FILE=/var/lib/poc/events.jsonl
# XAI_API_KEY (Grok) and AGENT_TOKEN (read-only access to the barn-owl dashboard): push-poc.sh --secrets
EnvironmentFile=-/etc/poc/env
ExecStart=/srv/poc/src/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8772 --proxy-headers
Restart=always
RestartSec=2
MemoryMax=250M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/poc

[Install]
WantedBy=multi-user.target
